# kernel modules are rebuilt from nvmevirt/ (checksums are kept in modules/<variant>/SHA256SUMS)
modules/*/*.ko
# python virtualenv for analysis
.venv/
__pycache__/
# one-page HTML galleries (make_gallery.py): large, the PNGs they contain are committed
results/*/gallery_*.html
# lock of run_rocksdb_ycsb.sh (one instance at a time)
results/.rocksdb_ycsb.lock
