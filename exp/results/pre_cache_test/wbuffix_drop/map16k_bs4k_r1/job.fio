; KSC2026 NVMeVirt mapping-unit experiment — fresh-device random write.
; Template: run_experiment.sh replaces @VARS@ and saves the concrete job file as <run dir>/job.fio
[global]
filename=/dev/nvme1n1
ioengine=libaio
direct=1
rw=randwrite
bs=4k
iodepth=32
numjobs=1
time_based=1
runtime=8
ramp_time=0
group_reporting=1
; same random offset sequence in every run (fio default, written out for clarity)
randrepeat=1
percentile_list=50:90:95:99:99.9:99.99
; time series (averaged over 500 ms) to see the pre-GC and post-GC parts of the run
write_bw_log=/home/dccearth/jsw/KSC2026/nvmevirt/exp/results/pre_cache_test/wbuffix_drop/map16k_bs4k_r1/fio
write_iops_log=/home/dccearth/jsw/KSC2026/nvmevirt/exp/results/pre_cache_test/wbuffix_drop/map16k_bs4k_r1/fio
write_lat_log=/home/dccearth/jsw/KSC2026/nvmevirt/exp/results/pre_cache_test/wbuffix_drop/map16k_bs4k_r1/fio
log_avg_msec=500

[randwrite]
