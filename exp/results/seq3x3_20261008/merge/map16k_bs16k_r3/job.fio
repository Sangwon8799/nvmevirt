; KSC2026 NVMeVirt mapping-unit experiment — fresh-device sequential write.
; Template: run_experiment.sh replaces @VARS@ and saves the concrete job file as <run dir>/job.fio
[global]
filename=/dev/nvme1n1
ioengine=libaio
direct=1
rw=write
; time_based: after the last block of the device fio wraps around to offset 0 and keeps writing sequentially
bs=16k
iodepth=32
numjobs=1
time_based=1
runtime=60
ramp_time=0
group_reporting=1
percentile_list=50:90:95:99:99.9:99.99
; time series (averaged over 500 ms) to see the pre-GC and post-GC parts of the run
write_bw_log=/home/dccearth/jsw/nvmevirt/exp/results/seq3x3_20261008/merge/map16k_bs16k_r3/fio
write_iops_log=/home/dccearth/jsw/nvmevirt/exp/results/seq3x3_20261008/merge/map16k_bs16k_r3/fio
write_lat_log=/home/dccearth/jsw/nvmevirt/exp/results/seq3x3_20261008/merge/map16k_bs16k_r3/fio
log_avg_msec=500

[seqwrite]
