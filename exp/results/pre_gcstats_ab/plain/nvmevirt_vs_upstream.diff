+/****************************************************************
+ * Memory Layout
+ ****************************************************************
+ * virtDev
+ *  - PCI header
+ *    -> BAR at 1MiB area
+ *  - PCI capability descriptors
+ *
+ * +--- memmap_start
+ * |
+ * v
+ * +--------------+------------------------------------------+
+ * | <---1MiB---> | <---------- Storage Area --------------> |
+ * +--------------+------------------------------------------+
+ *
+ * 1MiB area for metadata
+ *  - BAR : 1 page
+ *	- DBS : 1 page
+ *	- MSI-x table: 16 bytes/entry * 32
+ *
+ * Storage area
+ *
+ ****************************************************************/
+
+/****************************************************************
+ * Argument
+ ****************************************************************
+ * 1. Memmap start
+ * 2. Memmap size
+ ****************************************************************/
+
+struct nvmev_dev *nvmev_vdev = NULL;
