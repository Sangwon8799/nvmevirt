+
+.PHONY: clean
+clean:
+	   $(MAKE) -C $(KERNELDIR) M=$(PWD) clean
+	   rm -f cscope.out tags nvmev.S
+
+.PHONY: cscope
+cscope:
+		cscope -b -R
+		ctags *.[ch]
+
+.PHONY: tags
+tags: cscope
+
+.PHONY: format
+format:
+	clang-format -i *.[ch]
+
+.PHONY: dis
+dis:
+	objdump -d -S nvmev.ko > nvmev.S
