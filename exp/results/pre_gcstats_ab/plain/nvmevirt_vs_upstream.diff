+static inline unsigned int hash_function(char *key, const int length)
+{
+	unsigned char *p = key;
+	unsigned int h = 2166136261;
+	int i;
+
+	for (i = 0; i < length; i++)
+		h = (h * 16777619) ^ p[i];
+
+	return h;
+}
